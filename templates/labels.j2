{% if open_webui_container_labels_traefik_enabled %}
traefik.enable=true

{% if open_webui_container_labels_traefik_docker_network %}
traefik.docker.network={{ open_webui_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if open_webui_container_labels_traefik_middleware_basic_auth_enabled %}
{% set middlewares = middlewares + [open_webui_identifier + '-basic-auth'] %}
traefik.http.middlewares.{{ open_webui_identifier }}-basic-auth.basicauth.users={{ open_webui_container_labels_traefik_middleware_basic_auth_users }}
{% endif %}

{% if open_webui_container_labels_traefik_compression_middleware_enabled %}
{% set middlewares = middlewares + [open_webui_container_labels_traefik_compression_middleware_name] %}
{% endif %}

{#
  Intentionally not adding redirectRegex and stripPrefix middleware.
  Open WebUI does not support hosting under a subpath, so it is always served at `/`.
#}

{% if open_webui_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in open_webui_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ open_webui_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [open_webui_identifier + '-add-request-headers'] %}
{% endif %}

{% if open_webui_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in open_webui_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ open_webui_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [open_webui_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ open_webui_identifier }}.rule={{ open_webui_container_labels_traefik_rule }}
{% if open_webui_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ open_webui_identifier }}.priority={{ open_webui_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ open_webui_identifier }}.service={{ open_webui_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ open_webui_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ open_webui_identifier }}.entrypoints={{ open_webui_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ open_webui_identifier }}.tls={{ open_webui_container_labels_traefik_tls | to_json }}
{% if open_webui_container_labels_traefik_tls %}
traefik.http.routers.{{ open_webui_identifier }}.tls.certResolver={{ open_webui_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ open_webui_identifier }}.loadbalancer.server.port={{ open_webui_container_http_port }}
{% endif %}

{% for arg in open_webui_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
