TZ={{ open_webui_environment_variables_tz }}

{#
  See: https://docs.openwebui.com/reference/env-configuration
#}

WEBUI_URL={{ open_webui_environment_variables_webui_url }}
WEBUI_SECRET_KEY={{ open_webui_environment_variables_webui_secret_key }}
CORS_ALLOW_ORIGIN={{ open_webui_environment_variables_cors_allow_origin }}
WEBUI_SESSION_COOKIE_SECURE={{ open_webui_environment_variables_webui_session_cookie_secure | to_json }}

{% if open_webui_database_type == 'postgres' %}
DATABASE_URL={{ open_webui_environment_variables_database_url }}
{% endif %}

ENABLE_SIGNUP={{ open_webui_environment_variables_enable_signup | to_json }}
DEFAULT_USER_ROLE={{ open_webui_environment_variables_default_user_role }}

ENABLE_OLLAMA_API={{ open_webui_environment_variables_enable_ollama_api | to_json }}
OLLAMA_BASE_URL={{ open_webui_environment_variables_ollama_base_url }}

ENABLE_OPENAI_API={{ open_webui_environment_variables_enable_openai_api | to_json }}
OPENAI_API_BASE_URL={{ open_webui_environment_variables_openai_api_base_url }}
OPENAI_API_KEY={{ open_webui_environment_variables_openai_api_key }}

ENABLE_PERSISTENT_CONFIG={{ open_webui_environment_variables_enable_persistent_config | to_json }}

GLOBAL_LOG_LEVEL={{ open_webui_environment_variables_global_log_level }}

{{ open_webui_environment_variables_additional_variables }}
